{
  "name": "@apps/backend",
  "version": "1.0.3",
  "private": true,
  "description": "Electron main process + NestJS backend for Formatted Docs AI Translator",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "watch": "yarn build:watch",
    "fix:aliases": "tsc-alias -p tsconfig.json",
    "clean": "rimraf ../../dist && rimraf ../../dist/tsconfig.backend.tsbuildinfo ../../dist/tsconfig.swagger.tsbuildinfo",
    "build:swagger": "tsc -b tsconfig.swagger.json && tsc-alias -p ../common/tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "electron ../../dist/main.js",
    "start:debug": "electron --inspect=9229 ../../dist/main.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json}\"",
    "test": "jest --config ../../jest.config.js",
    "test:watch": "jest --config ../../jest.config.js --watch",
    "test:cov": "jest --config ../../jest.config.js --coverage",
    "test:debug": "TS_NODE_PROJECT=tsconfig.json node --inspect-brk -r tsconfig-paths/register -r ts-node/register ../../node_modules/.bin/jest --runInBand",
    "test:unit": "jest --config ../../jest.config.js --testPathPattern=apps/backend/src/",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:local": "cd ../../node_modules/better-sqlite3 && yarn node-gyp rebuild",
    "nest:generate": "nest generate",
    "nest:g:module": "nest generate module",
    "nest:g:controller": "nest generate controller",
    "nest:g:service": "nest generate service",
    "nest:g:provider": "nest generate provider",
    "nest:g:class": "nest generate class",
    "swagger:gen": "yarn build && IS_SWAGGER_GEN_MODE=true node ../../dist/nest/create-swagger.js",
    "package:win": "yarn build && electron-builder build --win",
    "package:linux": "yarn build && electron-builder build --linux",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:pull": "prisma db pull"
  },
  "dependencies": {
    "@apps/common": "workspace:*",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@google/genai": "^1.30.0",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-fastify": "^11.1.10",
    "@nestjs/swagger": "^11.2.1",
    "@prisma/client": "^6.19.0",
    "better-sqlite3": "^12.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.5",
    "electron-dl": "^4.0.0",
    "jszip": "^3.10.1",
    "limiter": "^2.1.0",
    "lru-cache": "^11.0.2",
    "openai": "latest",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rfdc": "^1.4.1",
    "rxjs": "^7.8.2",
    "semver": "^7.6.3",
    "sharp": "^0.34.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/dotenv": "^8.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.27",
    "@types/rfdc": "^1.2.0",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "electron": "35.2.2",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "electron-reloader": "^1.2.3",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "rebuild": "^0.1.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.15",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  }
}
