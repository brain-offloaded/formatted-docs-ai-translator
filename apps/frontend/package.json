{
  "name": "@apps/frontend",
  "version": "1.0.9",
  "private": true,
  "description": "Electron renderer for Formatted Docs AI Translator",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && webpack --config webpack.config.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "concurrently \"tsc -p tsconfig.json --watch\" \"webpack --config webpack.config.js --watch\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "fix:aliases": "tsc-alias -p tsconfig.json",
    "clean": "rimraf ../../dist/apps/frontend",
    "test": "jest --config ../../jest.frontend.config.js",
    "test:watch": "jest --config ../../jest.frontend.config.js --watch",
    "client:gen": "openapi -i ../backend/swagger.json -o ./src/react/api/generated --useOptions"
  },
  "dependencies": {
    "@apps/common": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.8",
    "@mui/material": "^6.4.8",
    "@mui/system": "^6.4.8",
    "electron": "39.8.5",
    "fitty": "^2.4.2",
    "i18next": "^25.6.0",
    "jszip": "^3.10.1",
    "lodash": "^4.17.23",
    "papaparse": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.1.0",
    "uuid": "^11.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "concurrently": "^8.2.2",
    "css-loader": "^7.1.2",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "openapi-typescript-codegen": "^0.29.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.2",
    "tsc-alias": "^1.8.15",
    "typescript": "^5.8.2",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}
